# Base de données du développement local (docker-compose.yml)
DATABASE_URL="postgresql://relnis:relnis_dev@localhost:5432/relnis?schema=public"

# Courriels : Mailpit en local (aucun envoi réel)
SMTP_URL="smtp://localhost:1025"
COURRIEL_EXPEDITEUR="Relnis <ne-pas-repondre@relnis.local>"

# Clé qui signe les jetons de connexion. En local, remplacer par une valeur au hasard :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Une autre clé, jamais commitée, en préproduction et en production.
JWT_SECRET="a-remplacer-par-une-cle-au-hasard-de-43-caracteres"

# Adresse de l'interface, pour les liens envoyés par courriel
URL_WEB="http://localhost:5173"
