// Conventions : tables au pluriel en snake_case, colonnes en snake_case (@map),
// identifiants UUID v7, dates en UTC (timestamptz).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRATEUR
  GESTIONNAIRE
  EMPLOYE
  COMPTABLE

  @@map("role")
}

enum Theme {
  CLAIR
  SOMBRE
  SYSTEME

  @@map("theme")
}

model Entreprise {
  id            String   @id @default(uuid(7)) @db.Uuid
  nom           String   @db.VarChar(200)
  pays          String   @default("CA") @db.Char(2)
  langue        String   @default("fr") @db.VarChar(5)
  fuseauHoraire String   @default("America/Toronto") @map("fuseau_horaire") @db.VarChar(64)
  devise        String   @default("CAD") @db.Char(3)
  creeLe        DateTime @default(now()) @map("cree_le") @db.Timestamptz(3)
  modifieLe     DateTime @updatedAt @map("modifie_le") @db.Timestamptz(3)

  utilisateurs Utilisateur[]

  @@map("entreprises")
}

/// Jamais supprimé : désactivé (actif = false).
model Utilisateur {
  id                    String    @id @default(uuid(7)) @db.Uuid
  entrepriseId          String    @map("entreprise_id") @db.Uuid
  prenom                String    @db.VarChar(100)
  nom                   String    @db.VarChar(100)
  /// Toujours enregistré en minuscules.
  courriel              String    @unique @db.VarChar(254)
  courrielVerifie       Boolean   @default(false) @map("courriel_verifie")
  motDePasseHache       String    @map("mot_de_passe_hache")
  role                  Role
  langue                String    @default("fr") @db.VarChar(5)
  theme                 Theme     @default(SYSTEME)
  accesTousEmplacements Boolean   @default(true) @map("acces_tous_emplacements")
  deuxFaActive          Boolean   @default(false) @map("deux_fa_active")
  actif                 Boolean   @default(true)
  derniereConnexion     DateTime? @map("derniere_connexion") @db.Timestamptz(3)
  creeLe                DateTime  @default(now()) @map("cree_le") @db.Timestamptz(3)
  modifieLe             DateTime  @updatedAt @map("modifie_le") @db.Timestamptz(3)

  entreprise Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Restrict)
  jetons     Jeton[]
  sessions   Session[]

  @@index([entrepriseId])
  @@map("utilisateurs")
}

enum TypeJeton {
  VERIFICATION_COURRIEL

  @@map("type_jeton")
}

/// Jeton à usage unique envoyé par courriel. Seul son haché (SHA-256) est enregistré.
model Jeton {
  id            String    @id @default(uuid(7)) @db.Uuid
  utilisateurId String    @map("utilisateur_id") @db.Uuid
  type          TypeJeton
  jetonHache    String    @unique @map("jeton_hache") @db.Char(64)
  expireLe      DateTime  @map("expire_le") @db.Timestamptz(3)
  utiliseLe     DateTime? @map("utilise_le") @db.Timestamptz(3)
  creeLe        DateTime  @default(now()) @map("cree_le") @db.Timestamptz(3)

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)

  @@index([utilisateurId])
  @@map("jetons")
}

enum MotifFermeture {
  DECONNEXION
  /// Un ancien jeton de renouvellement a resservi : probablement volé.
  REUTILISATION_DETECTEE

  @@map("motif_fermeture")
}

/// Une connexion ouverte sur un appareil. Seul le haché du jeton de renouvellement est enregistré.
model Session {
  id                       String          @id @default(uuid(7)) @db.Uuid
  utilisateurId            String          @map("utilisateur_id") @db.Uuid
  jetonRenouvellementHache String          @unique @map("jeton_renouvellement_hache") @db.Char(64)
  /// Le jeton remplacé au dernier renouvellement : s'il resservait, la session serait fermée.
  jetonPrecedentHache      String?         @unique @map("jeton_precedent_hache") @db.Char(64)
  renouveleeLe             DateTime?       @map("renouvelee_le") @db.Timestamptz(3)
  appareil                 String?         @db.VarChar(255)
  adresseIp                String?         @map("adresse_ip") @db.VarChar(45)
  derniereActiviteLe       DateTime        @default(now()) @map("derniere_activite_le") @db.Timestamptz(3)
  /// Inactivité : repoussée à chaque renouvellement.
  expireLe                 DateTime        @map("expire_le") @db.Timestamptz(3)
  /// Limite absolue : jamais repoussée.
  expireAbsoluLe           DateTime        @map("expire_absolu_le") @db.Timestamptz(3)
  fermeeLe                 DateTime?       @map("fermee_le") @db.Timestamptz(3)
  motifFermeture           MotifFermeture? @map("motif_fermeture")
  creeLe                   DateTime        @default(now()) @map("cree_le") @db.Timestamptz(3)

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)

  @@index([utilisateurId])
  @@map("sessions")
}
